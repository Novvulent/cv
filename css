/* Estilos propios - complementan a PicoCSS */

.hero {
  text-align: center;
  padding: 2rem 1rem;
}

section {
  margin-bottom: 2.5rem;
}

section h2 {
  border-bottom: 2px solid var(--pico-primary);
  padding-bottom: 0.3rem;
  margin-bottom: 1rem;
}

article {
  margin-bottom: 1rem;
}

footer {
  text-align: center;
  padding: 1rem;
  opacity: 0.7;
}

/* Responsive: ajustes para pantallas pequeñas */
@media (max-width: 600px) {
  nav ul {
    flex-wrap: wrap;
  }

  .hero h1 {
    font-size: 1.8rem;
  }
}

